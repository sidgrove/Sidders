<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleName</key>
	<string>Acapella</string>
	<key>CFBundleDisplayName</key>
	<string>Acapella</string>
	<!-- The executable keeps the Swift module's name: renaming the module touches every
	     file and cannot be verified without a Mac. It is an internal name; nothing the user
	     sees carries it. Space-free so `pkill -x` can never match another app. -->
	<key>CFBundleExecutable</key>
	<string>MurmurYouTube</string>
	<!-- The bundle identifier is the app's identity for TCC grants and preferences. It was
	     ai.pivotstudio.murmur-youtube before the 2026-09-12 rebrand; an existing install
	     will be asked for Microphone and Accessibility again, once. -->
	<key>CFBundleIdentifier</key>
	<string>com.sidgrove.acapella</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.2.0</string>
	<key>CFBundleVersion</key>
	<string>2</string>
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<!-- Lets the dashboard's Clear button call back into the app. A file:// page can't
	     write files or talk to a process, but it can follow a custom-scheme link. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.sidgrove.acapella</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>acapella</string>
			</array>
		</dict>
	</array>
	<key>LSMinimumSystemVersion</key>
	<string>26.0</string>
	<!-- A regular app: dock icon, app menu, standard windows. The menu bar item remains
	     for status and the hotkey while you're working elsewhere, but it is secondary. -->
	<key>LSUIElement</key>
	<false/>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSMicrophoneUsageDescription</key>
	<string>Acapella listens while you hold the push-to-talk key so it can turn your speech into text.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Acapella transcribes your speech on-device to insert text where you're typing.</string>
</dict>
</plist>
