<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Plain net10.0, NOT net10.0-windows. Avalonia is cross-platform, and this is what
         lets the UI be built and headless-tested on macOS — the reason Avalonia was chosen
         over WPF. Windows-only code lives in Murmur.Platform.Windows. -->
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Murmur.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationIcon>Assets/app.ico</ApplicationIcon>
    <AssemblyName>Acapella</AssemblyName>
    <AssemblyTitle>Acapella</AssemblyTitle>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Murmur.Core\Murmur.Core.csproj" />
    <ProjectReference Include="..\Murmur.Speech\Murmur.Speech.csproj" />
  </ItemGroup>

  <!-- The Windows platform layer targets net10.0-windows and is resolved by reflection at
       run time (see PlatformFactory). ReferenceOutputAssembly=false means it is BUILT and
       COPIED next to the app without being compiled against — which is what lets this
       project stay on plain net10.0 and therefore build and headless-test on macOS.
       Skipped entirely off Windows, where it cannot compile. -->
  <PropertyGroup Condition="'$([System.OperatingSystem]::IsWindows())' == 'true'">
    <!-- The one folder the platform layer is ever built into. Every glob below reads from
         here, and the ProjectReference is pinned so that it always writes here. -->
    <PlatformLayerDir>..\Murmur.Platform.Windows\bin\$(Configuration)\net10.0-windows\</PlatformLayerDir>
  </PropertyGroup>

  <ItemGroup Condition="'$([System.OperatingSystem]::IsWindows())' == 'true'">
    <!-- SkipGetTargetFrameworkProperties is required: without it MSBuild refuses the
         reference outright ("targets net10.0-windows, cannot be referenced by a project
         that targets .NETCoreApp") before ReferenceOutputAssembly is ever considered.

         UndefineProperties must also strip RuntimeIdentifier and the publish properties.
         `dotnet publish -r win-x64` passes them as GLOBAL properties, and without this they
         flowed into the referenced build and moved its output to
         bin\Release\net10.0-windows\win-x64\ — a folder nothing else looked in. The
         Build-time copy then warned MSB3030 and shipped nothing; only a second, separate
         publish-time rebuild saved the artifact. Pinning the reference removes the need
         for that second build entirely. -->
    <ProjectReference Include="..\Murmur.Platform.Windows\Murmur.Platform.Windows.csproj"
                      ReferenceOutputAssembly="false"
                      SkipGetTargetFrameworkProperties="true"
                      UndefineProperties="TargetFramework;RuntimeIdentifier;SelfContained;PublishSingleFile;IncludeNativeLibrariesForSelfExtract;PublishDir;DebugType;_IsPublishing"
                      Private="false" />
  </ItemGroup>

  <!-- ReferenceOutputAssembly=false suppresses the copy too, so bring the assembly across
       explicitly. The platform layer has already been built by the ProjectReference above
       by the time either target runs, so both just read $(PlatformLayerDir). A missing file
       is an ERROR, not a warning: when this layer fails to ship, the app starts perfectly
       and then does nothing at all when the key is pressed (README, "What real hardware
       found"). PlatformFactory resolves the assembly by name at startup. -->
  <Target Name="CollectWindowsPlatformLayer"
          Condition="'$([System.OperatingSystem]::IsWindows())' == 'true'">
    <ItemGroup>
      <PlatformLayer Include="$(PlatformLayerDir)Murmur.Platform.Windows.dll" />
      <PlatformLayer Include="$(PlatformLayerDir)NAudio*.dll" />
    </ItemGroup>
    <Error Condition="!Exists('$(PlatformLayerDir)Murmur.Platform.Windows.dll')"
           Text="Murmur.Platform.Windows.dll was not found in $(PlatformLayerDir). The platform layer did not build where Murmur.App expects it." />
    <Error Condition="!Exists('$(PlatformLayerDir)NAudio.Wasapi.dll')"
           Text="NAudio.Wasapi.dll was not found in $(PlatformLayerDir). Check CopyLocalLockFileAssemblies in Murmur.Platform.Windows.csproj." />
  </Target>

  <Target Name="CopyWindowsPlatformLayer"
          AfterTargets="Build"
          DependsOnTargets="CollectWindowsPlatformLayer"
          Condition="'$([System.OperatingSystem]::IsWindows())' == 'true'">
    <Copy SourceFiles="@(PlatformLayer)"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="PublishWindowsPlatformLayer"
          BeforeTargets="ComputeResolvedFilesToPublishList"
          DependsOnTargets="CollectWindowsPlatformLayer"
          Condition="'$([System.OperatingSystem]::IsWindows())' == 'true'">
    <ItemGroup>
      <!-- Loose beside the exe rather than inside the bundle: PublishSingleFile only bundles
           assemblies the compiler knows about, and this one is deliberately invisible to it.
           The default load context probes AppContext.BaseDirectory, and Program.cs installs
           a resolver as a belt-and-braces fallback. -->
      <ResolvedFileToPublish Include="@(PlatformLayer)">
        <RelativePath>%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
