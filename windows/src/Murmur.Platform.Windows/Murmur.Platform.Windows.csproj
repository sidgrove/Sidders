<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- The ONLY project in the repo allowed to call Win32. Keep it thin: anything with
         logic in it is code CI cannot exercise. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Murmur.Platform.Windows</RootNamespace>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>

    <!-- Found on the first real-hardware run: a class library does NOT copy its package
         assemblies to bin/, so NAudio.Core/Wasapi/WinMM were never beside this DLL, and
         both Murmur.App's copy step and its publish step glob NAudio*.dll from exactly that
         folder. The app started, the hook armed, and the first key press threw
         FileNotFoundException inside an unobserved task. This makes the folder complete. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Murmur.Abstractions\Murmur.Abstractions.csproj" />
  </ItemGroup>
</Project>
